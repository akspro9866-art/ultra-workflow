# Ultra Workflow — enforce LF so Windows checkouts never break Linux cloud chats.
* text=auto eol=lf

*.ts text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
dist/ultra text eol=lf
dist/ultra.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.zip binary
*.mp4 binary
*.mov binary
*.wav binary
*.cube binary

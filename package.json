{
  "name": "ultra-workflow",
  "version": "1.0.0",
  "description": "Zero-API deterministic video compiler for agent chat sandboxes (Gemini / Meta Muse). Agent-as-brain, Ultra-as-engine.",
  "private": true,
  "type": "module",
  "bin": {
    "ultra": "dist/bin/ultra.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:ts && npm run test:python",
    "test:ts": "vitest run --config vitest.config.ts",
    "test:python": "node scripts/run-python-test.mjs",
    "test:phase1": "vitest run --config vitest.config.ts tests/phase1.probe-schema.test.ts",
    "test:phase2": "vitest run --config vitest.config.ts tests/phase2.assets-stitch.test.ts",
    "test:phase3": "vitest run --config vitest.config.ts tests/phase3.hyperframes.test.ts",
    "test:phase4": "vitest run --config vitest.config.ts tests/phase4.multi-engine.test.ts",
    "test:phase5": "vitest run --config vitest.config.ts tests/phase5.blender-3d.test.ts",
    "test:phase6": "vitest run --config vitest.config.ts tests/phase6.verify-patch.test.ts",
    "test:phase7": "vitest run --config vitest.config.ts tests/phase7.cloud-bundle.test.ts",
    "test:phase8": "vitest run --config vitest.config.ts tests/phase8.style-system.test.ts",
    "pack:cloud": "npm run build && node dist/scripts/pack-cloud.js",
    "setup:engines": "node scripts/setup-engines.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "playwright-core": "^1.49.0",
    "three": "^0.169.0",
    "ws": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
